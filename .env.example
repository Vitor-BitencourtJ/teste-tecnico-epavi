# Copie este arquivo para .env e preencha os valores.
# O .env fica fora do git; este modelo é versionado.

# Chave da API da central (obrigatória). A da API mock está em api_mock/README_API.md.
CENTRAL_API_KEY=

# Opcionais: os valores abaixo já são o padrão.
# CENTRAL_API_URL=http://127.0.0.1:8000
# CENTRAL_API_TIMEOUT=30
# CENTRAL_API_INTERVALO_MIN=0.25
# CENTRAL_API_MAX_TENTATIVAS=8
# CENTRAL_API_POR_PAGINA=200
# CENTRAL_BANCO=dados/central.db
# CENTRAL_LOGS=logs
# CENTRAL_PAINEL_ATUALIZAR_SEG=120   # o iniciar.py ajusta sozinho pelo --intervalo
